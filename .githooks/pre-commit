#!/bin/sh
set -e

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "main is protected; commit on a feature branch" >&2
  exit 1
fi

root=$(git rev-parse --show-toplevel)
if [ -f "$root/.repo-safety/scripts/forbid_sensitive_files.py" ]; then
  python "$root/.repo-safety/scripts/forbid_sensitive_files.py"
fi
